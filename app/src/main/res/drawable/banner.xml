<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF8A00"
                android:startColor="#B25CFF" />
        </shape>
    </item>
    <item
        android:bottom="30dp"
        android:left="40dp"
        android:right="40dp"
        android:top="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#1B1B1F" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
